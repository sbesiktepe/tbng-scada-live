# TBNG SCADA Live - copy to .env (never commit .env)
# DNS name that points to THIS cloud server (Let's Encrypt needs ports 80 and 443 open).
SITE_ADDRESS=live.tbngltd.com
# One shared read-only account for everybody.
LIVE_USER=tbng
# Hash of the password:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'PASSWORD'
# Put it in SINGLE quotes (the $ signs must stay as they are).
LIVE_PASSWORD_HASH='CHANGE_ME'
# Seconds between two reads of one device (mobile data!). 30 is the minimum by default.
MIN_POLL_SECONDS=30
